{
  "name": "ziko",
  "version": "2.0.0-beta.0",
  "description": "A versatile JavaScript library offering a rich set of Hyperscript Based UI components, advanced mathematical utilities, interactivity ,animations, client side routing and more ...",
  "keywords": [
    "front-end",
    "framework",
    "zikojs",
    "ziko",
    "math",
    "user-interface",
    "time",
    "dom",
    "single page application",
    "file based routing"
  ],
  "type": "module",
  "main": "dist/ziko.mjs",
  "module": "dist/ziko.mjs",
  "unpkg": "dist/ziko.min.js",
  "files": [
    "src",
    "dist",
    "LICENCE"
  ],
  "exports": {
    "./*": {
      "import": "./src/*/index.js",
      "types": "./src/*/index.d.ts"
    },
    ".": {
      "import": "./dist/ziko.mjs",
      "require": "./dist/ziko.cjs"
    }
  },
  "sideEffects": true,
  "scripts": {
    "test": "npx vitest",
    "test-link": "node _link/index.js",
    "lint": "eslint src/*/*/*",
    "dev": "cross-env NODE_ENV=development rollup --config rollup.config.js",
    "watch": "cross-env NODE_ENV=development rollup --config rollup.config.js -w",
    "build": "cross-env NODE_ENV=production rollup --config rollup.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zikojs/ziko.git",
    "directory": "packages/ziko"
  },
  "author": "zakaria elalaoui",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zikojs/ziko/issues"
  },
  "homepage": "https://github.com/zikojs/ziko#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "rollup": "catalog:"
  }
}
